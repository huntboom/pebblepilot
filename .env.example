# Copy to .env and fill in real values:
#   cp .env.example .env

# Cursor API key (https://cursor.com/dashboard/integrations)
CURSOR_API_KEY=

# Daemon auth token (long random string; must match Clay "Daemon token")
PEBBLEPILOT_TOKEN=change-me-to-a-long-random-string

# Bind address / port for the daemon
PEBBLEPILOT_HOST=0.0.0.0
PEBBLEPILOT_PORT=8787

# LAN or Tailscale IP your phone can reach (never 0.0.0.0 / 127.0.0.1)
PEBBLEPILOT_LAN_HOST=192.168.1.x

# Local checkouts (preferred). Agents cd here — no clone if .git exists.
PEBBLEPILOT_GITHUB_USER=huntboom
PEBBLEPILOT_REPOS_ROOT=/home/you/github
# Fine-grained or classic PAT with repo read (needed for private repos)
GITHUB_TOKEN=
# Set to 0 to only show local folders (skip GitHub API remote-only repos)
# PEBBLEPILOT_INCLUDE_REMOTE=0

# Optional override for config.json location
# PEBBLEPILOT_CONFIG=/absolute/path/to/config.json
